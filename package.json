{
  "name": "gyutae-kim-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration=production --output-path docs --base-href / && ng run portfolio:server:production && node tools/route-pages.mjs docs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy": "npm run build && npm run check:seo && npx gh-pages -d docs --dotfiles",
    "preview": "ng serve --host 127.0.0.1 --port 4317",
    "check:seo": "node tools/check-seo.mjs docs",
    "update:content-dates": "ng run portfolio:server:production && node tools/update-content-dates.mjs",
    "test:content-dates": "node --test tools/content-dates.test.mjs",
    "sync:viewer-date": "node tools/sync-linked-dates.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^15.2.0",
    "@angular/compiler": "^15.2.0",
    "@angular/core": "^15.2.0",
    "@angular/platform-browser": "^15.2.0",
    "@angular/platform-browser-dynamic": "^15.2.0",
    "@angular/platform-server": "15.2.6",
    "@angular/router": "^15.2.0",
    "rxjs": "~7.8.0",
    "three": "0.160.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.12.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^15.2.5",
    "@angular/cli": "~15.2.5",
    "@angular/compiler-cli": "^15.2.0",
    "@types/jasmine": "~4.3.0",
    "@types/three": "0.160.0",
    "gh-pages": "^5.0.0",
    "jasmine-core": "~4.5.0",
    "jsdom": "^22.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~4.9.4"
  }
}
